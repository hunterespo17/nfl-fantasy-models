# Trained models and generated pages are reproducible, so they don't belong in
# version control.
models/
outputs/

# Same for the downloaded nflverse cache -- it's big and it re-downloads itself.
# The hand-kept CSVs are the exception: draft prices, play-callers and win
# totals are typed once and are the ONLY numbers the website's builder can't
# fetch for itself. If these don't get committed, the live site builds with no
# prices and every player is graded against nothing.
data/*
!data/*.csv

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
